# Firebase Web App Credentials
# Create a project at https://console.firebase.google.com and add a Web App
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=campussync-ait.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=campussync-ait
VITE_FIREBASE_STORAGE_BUCKET=campussync-ait.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id_here

# Optional: Set to "true" to force local simulated backend even if keys are present
VITE_USE_DEMO_MODE=false

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HELPER FUNCTIONS FOR CAMPUSYNC SECURITY
    // ==========================================
    
    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if user is signed in with @aitpune.edu.in domain
    function isAITStudent() {
      return isSignedIn() && 
             request.auth.token.email.matches('^[a-zA-Z0-9._%+-]+@aitpune\\.edu\\.in$');
    }
    
    // Check if user's email is verified
    function isVerifiedAIT() {
      return isAITStudent() && request.auth.token.email_verified == true;
    }
    
    // Check if current user is owner of resource
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      // Any authenticated campus user can read profiles (ratings, hostel block)
      allow read: if isSignedIn();
      // Only the user themselves can create or update their own profile
      allow create, update: if isOwner(userId);
      allow delete: if false; // Profiles shouldn't be deleted directly
    }

    // ==========================================
    // LISTINGS COLLECTION
    // ==========================================
    match /listings/{listingId} {
      // Anyone signed in can browse campus items
      allow read: if isSignedIn();
      
      // Only verified AIT students can create listings
      allow create: if isVerifiedAIT() && 
                    request.resource.data.ownerId == request.auth.uid &&
                    request.resource.data.transactionType in ['Rent', 'Sell', 'Skill-Barter'] &&
                    request.resource.data.title.size() > 2;
      
      // Only listing owner can update or delete their listing
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        // Allow status updates during negotiation if participating
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
      
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ==========================================
    // CHATS & MESSAGES (PEER-TO-PEER)
    // ==========================================
    match /chats/{chatId} {
      // Only chat participants can read the conversation
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants);
      
      // Creating a chat requires being one of the participants and verified
      allow create: if isVerifiedAIT() && (request.auth.uid in request.resource.data.participants);
      
      // Updating chat (lastMessage, unread count) requires being a participant
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants);
      
      // Subcollection for individual messages
      match /messages/{messageId} {
        allow read: if isSignedIn() && 
                    request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
                    
        allow create: if isVerifiedAIT() && 
                     request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                     request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}

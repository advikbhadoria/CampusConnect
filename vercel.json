{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/", "destination": "/homepage/homepage.html" },
    { "source": "/Clubs", "destination": "/Clubs/dist/index.html" },
    { "source": "/Clubs/", "destination": "/Clubs/dist/index.html" },
    { "source": "/Clubs/(.*)", "destination": "/Clubs/dist/$1" },
    { "source": "/Complain", "destination": "/Complain/dist/index.html" },
    { "source": "/Complain/", "destination": "/Complain/dist/index.html" },
    { "source": "/Complain/(.*)", "destination": "/Complain/dist/$1" },
    { "source": "/Borrow", "destination": "/Borrow/dist/index.html" },
    { "source": "/Borrow/", "destination": "/Borrow/dist/index.html" },
    { "source": "/Borrow/(.*)", "destination": "/Borrow/dist/$1" },
    { "source": "/Shops", "destination": "/Shops/index.html" },
    { "source": "/Shops/", "destination": "/Shops/index.html" },
    { "source": "/Shops/(.*)", "destination": "/Shops/$1" },
    { "source": "/shop.css", "destination": "/Shops/shop.css" },
    { "source": "/shop.js", "destination": "/Shops/shop.js" },
    { "source": "/shops-data.js", "destination": "/Shops/shops-data.js" },
    { "source": "/assets/(.*)", "destination": "/Complain/dist/assets/$1" },
    { "source": "/Aakriti", "destination": "/Aakriti/aakriti.html" },
    { "source": "/Aakriti/", "destination": "/Aakriti/aakriti.html" },
    { "source": "/Aakriti/(.*)", "destination": "/Aakriti/$1" },
    { "source": "/aakriti.css", "destination": "/Aakriti/aakriti.css" },
    { "source": "/aakriti.js", "destination": "/Aakriti/aakriti.js" },
    { "source": "/Outpass", "destination": "/Outpass/outpass.html" },
    { "source": "/Outpass/", "destination": "/Outpass/outpass.html" },
    { "source": "/Outpass/(.*)", "destination": "/Outpass/$1" },
    { "source": "/outpass.css", "destination": "/Outpass/outpass.css" },
    { "source": "/outpass.js", "destination": "/Outpass/outpass.js" },
    { "source": "/Student-details", "destination": "/Student-details/student-details.html" },
    { "source": "/Student-details/", "destination": "/Student-details/student-details.html" },
    { "source": "/Feed", "destination": "/Feed/feed.html" },
    { "source": "/Feed/", "destination": "/Feed/feed.html" }
  ]
}
